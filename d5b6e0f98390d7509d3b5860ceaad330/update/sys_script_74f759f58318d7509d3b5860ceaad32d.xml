        <script><![CDATA[(function executeRule(current, previous) {

	var service = current.getValue('service');
	var groupName = '';

	switch (service) {
		case 'vpn':
		case 'database':
			groupName = 'Security Team';
			break;

		case 'github':
			groupName = 'Application Owners';
			break;

		case 'aws':
			groupName = 'IAM Admins';
			break;
	}

	if (groupName) {
		var group = new GlideRecord('sys_user_group');
		group.addQuery('name', groupName);
		group.query();

		if (group.next()) {
			current.setValue('assignment_group', group.getUniqueValue());
		}
	}

})(current, previous);]]></script>
